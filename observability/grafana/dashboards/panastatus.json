      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort(min by (service_id) (panastatus_ssl_days_left))",
          "refId": "A",
          "legendFormat": "{{service_id}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: días",
          "decimals": 0,
          "min": 0,
          "max": 365,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 14
              },
              {
                "color": "#0ca30c",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      }
    },
