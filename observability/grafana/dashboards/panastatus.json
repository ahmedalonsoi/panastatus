{
  "uid": "panastatus-ops",
  "title": "PanaStatus — Operación",
  "description": "Salud del monitor: servicios, latencia, API, bot y logs.",
  "tags": [
    "panastatus"
  ],
  "timezone": "America/Panama",
  "refresh": "1m",
  "time": {
