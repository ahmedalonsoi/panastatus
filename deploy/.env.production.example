# .env del SERVIDOR (/opt/panastatus/.env). Se crea a mano UNA vez, por SSH; nunca va a git.
# Genera las contraseñas con:  python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- Dominio y HTTPS ---
DOMAIN=panastatus.com
ACME_EMAIL=panastatus.contacto@gmail.com
PUBLIC_URL=https://panastatus.com

# --- Imágenes (las actualiza el despliegue automático; estos son valores de ejemplo) ---
APP_IMAGE=ghcr.io/TU_USUARIO/panastatus-app:latest
WEB_IMAGE=ghcr.io/TU_USUARIO/panastatus-web:latest

# --- Base de datos ---
POSTGRES_USER=panastatus
POSTGRES_PASSWORD=
POSTGRES_DB=panastatus
DATABASE_URL=postgresql://panastatus:CAMBIAR@db:5432/panastatus

# --- Monitoreo responsable ---
MONITOR_CONTACT=panastatus.contacto@gmail.com

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=

# --- Observabilidad ---
GRAFANA_ADMIN_PASSWORD=

# --- Post-mortems con IA (opcional; sin clave, la función queda apagada) ---
ANTHROPIC_API_KEY=
