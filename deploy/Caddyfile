# Caddy: servidor web y "puerta de entrada" de PanaStatus.
#
# - Sirve la página estática (Next.js exportado en /srv).
# - Reenvía /api/* y /health a FastAPI (contenedor "api").
# - HTTPS automático: si SITE_ADDRESS es un dominio (p. ej. panastatus.com), Caddy pide y
#   renueva solo el certificado de Let's Encrypt. En local SITE_ADDRESS=":80" (solo HTTP).
#
# Las variables {$VAR} vienen del entorno del contenedor (docker compose).

{
	# Correo para avisos de Let's Encrypt (vencimiento de certificados, etc.).
	email {$ACME_EMAIL:admin@localhost}
	# Logs de acceso en JSON → Loki los indexa igual que los de Python.
	log {
		format json
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Cabeceras de seguridad para TODAS las respuestas.
	header {
		# Solo HTTPS durante 1 año (los navegadores la ignoran en http://localhost).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		# No anunciar qué servidor usamos.
		-Server
	}

	# Compatibilidad: la página del bot antes era /bot.html (está en User-Agents viejos).
	redir /bot.html /bot/ permanent

	# --- API (FastAPI) ---
	@api path /api/* /health
	handle @api {
		reverse_proxy api:8000
	}

	# --- Sitio estático ---
	handle {
		root * /srv
		# Content-Security-Policy: el navegador solo ejecuta código de NUESTRO dominio.
		# 'unsafe-inline' es necesario porque Next.js incrusta pequeños scripts de arranque.
		# (No se aplica a /api/docs, que carga Swagger UI desde un CDN.)
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		# Los archivos de /_next/static llevan un hash en el nombre: se pueden cachear 1 año.
		header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/index.html {path}.html
		file_server
	}

	handle_errors 404 {
		root * /srv
		rewrite * /404.html
		file_server
	}
}
