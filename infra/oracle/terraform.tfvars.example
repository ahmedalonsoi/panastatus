# Copia este archivo a terraform.tfvars y completa los valores.
# terraform.tfvars NUNCA se sube a git (está en .gitignore).

# Consola OCI → Perfil (arriba a la derecha) → "API keys" → "Add API key".
# Al terminar, OCI muestra un bloque de configuración con estos valores.
tenancy_ocid     = "ocid1.tenancy.oc1..xxxxxxxx"
user_ocid        = "ocid1.user.oc1..xxxxxxxx"
fingerprint      = "aa:bb:cc:..."
private_key_path = "C:/Users/TU_USUARIO/.oci/panastatus_api_key.pem"
region           = "us-ashburn-1" # tu región HOME (la que elegiste al crear la cuenta)

# Tu clave pública SSH: contenido de C:/Users/TU_USUARIO/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAA... tu-pc"

# Tu IP pública + /32 (búscala en https://ifconfig.me). Solo ella podrá entrar por SSH.
admin_cidr = "203.0.113.10/32"

budget_alert_email = "tu-correo@ejemplo.com"

# Opcional (Always Free desde ago-2026: 2 OCPU y 12 GB en total)
# instance_ocpus     = 2
# instance_memory_gb = 12
# boot_volume_gb     = 100
