# Copia este archivo a .env y completa los valores. .env NUNCA se sube a git.

# --- Base de datos (Docker Compose usa estas tres para crear la DB) ---
POSTGRES_USER=panastatus
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=panastatus
# Para correr el código fuera de Docker (en tu PC). Dentro de Docker, compose la sobrescribe.
DATABASE_URL=postgresql://panastatus:cambia-esta-clave@localhost:5432/panastatus

# --- Monitoreo responsable ---
# Va en el User-Agent para que los administradores de los sitios puedan contactarte.
# El checker NO arranca si está vacío.
MONITOR_CONTACT=
# URL pública del proyecto (también va en el User-Agent)
PUBLIC_URL=http://localhost:8080

# Solo desarrollo: permite que `npm run dev` (localhost:3000) llame a la API en :8000.
CORS_ORIGINS=http://localhost:3000

# --- Telegram ---
# Token de @BotFather. Vacío = las alertas solo se escriben en el log.
TELEGRAM_BOT_TOKEN=
# Tu chat_id personal (escríbele a @userinfobot para saberlo). Recibe TODAS las alertas.
ADMIN_CHAT_ID=
